---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Página não encontrada | Imagine Comunicação Digital"
  description="Não encontramos esta página. Você pode conhecer as soluções da Imagine ou entrar em contato com nossa equipe."
  pathname="/404/"
  noindex={true}
>
  <section class="hero">
    <div class="shell error-content">
      <p class="eyebrow">Erro 404 · Página não encontrada</p>
      <h1>Não encontramos a página que você procura.</h1>
      <p class="lead">O endereço pode ter mudado ou estar incorreto. Continue navegando pelas soluções da Imagine ou converse com nossa equipe.</p>
      <div class="cta-row">
        <a class="cta" href="/servicos/">Conhecer nossos serviços</a>
        <a class="cta cta-secondary" href="/contato/">Entrar em contato</a>
        <a class="text-link" href="/">Voltar à página inicial</a>
      </div>
    </div>
  </section>
  <style>.error-content{padding-block:30px 70px}.error-content h1{max-width:720px}.error-content .cta-row{align-items:center}</style>
</BaseLayout>
