---
import BaseLayout from '../layouts/BaseLayout.astro';
import {commercialFaqSections} from '../data/commercial-faq.mjs';
const pathname='/perguntas-frequentes/';
---
<BaseLayout
  title="Perguntas frequentes sobre serviços digitais | Imagine"
  description="Dúvidas sobre orçamento, escopo, Landing Pages, anúncios, revisões, resultados, Portal do Cliente e cuidados com acessos antes da contratação."
  pathname={pathname}
  breadcrumb={[{label:'Perguntas frequentes',path:pathname}]}
>
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">Dúvidas antes da contratação</p>
      <h1>Perguntas frequentes para planejar com clareza.</h1>
      <p class="lead">Veja orientações gerais sobre escopo, valores, anúncios, revisões e canais de atendimento. As respostas são informativas: a proposta vigente é que define as condições do serviço contratado.</p>
      <div class="cta-row">
        <a class="cta" href="#respostas">Consultar respostas</a>
        <a class="cta cta-secondary" href="/como-funciona/">Entender o processo</a>
      </div>
    </div>
  </section>
  <nav class="section shell faq-index" aria-label="Índice de perguntas frequentes">
    <h2>Encontre sua dúvida</h2>
    <p>Escolha um tema ou uma pergunta para ir diretamente à resposta. Os links não registram nem enviam sua escolha.</p>
    <ul class="faq-index-topics">
      {commercialFaqSections.map(section=>(
        <li>
          <a href={'#faq-'+section.code}>{section.title}</a>
          <ul>
            {section.questions.map(item=>(
              <li><a href={'#duvida-'+item.id}>{item.question}</a></li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </nav>
  <div id="respostas">
    {commercialFaqSections.map((section,index)=>(
      <section class:list={['section',index%2===0?'section-soft':'']} aria-labelledby={'faq-'+section.code}>
        <div class="shell">
          <p class="kicker">Perguntas frequentes</p>
          <h2 id={'faq-'+section.code}>{section.title}</h2>
          <div class="faq-list">
            {section.questions.map(item=>(
              <div id={'duvida-'+item.id} class="faq-entry">
                <details class="faq-item">
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))}
  </div>
  <section class="section shell">
    <h2>Ficou alguma dúvida sobre o seu projeto?</h2>
    <p class="lead">Prepare as informações essenciais do briefing ou compare as soluções antes de conversar com a Imagine. Não envie senhas ou dados sensíveis pelos links públicos.</p>
    <div class="cta-row">
      <a class="cta" href="/contato/">Entrar em contato</a>
      <a class="cta cta-secondary" href="/comparar-solucoes/">Comparar soluções</a>
    </div>
  </section>
  <script>
    // F191: only known FAQ question IDs can expand native answers.
    // Navigation is local; no client data is read, stored or transmitted.
    const approved=new Set([...document.querySelectorAll<HTMLElement>('.faq-entry[id]')]
      .map(item=>item.id));
    const reveal=()=>{
      const anchor=window.location.hash.slice(1);
      if(!approved.has(anchor))return;
      const entry=document.getElementById(anchor);
      const answer=entry?.querySelector<HTMLDetailsElement>('details.faq-item');
      if(answer)answer.open=true;
    };
    window.addEventListener('hashchange',reveal);
    reveal();
  </script>
  <style>
    .faq-index{padding-top:38px;padding-bottom:38px}
    .faq-index p{max-width:700px}
    .faq-index-topics{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,245px),1fr));gap:20px;padding:0;list-style:none}
    .faq-index-topics>li>a{font-weight:800;color:#884100}
    .faq-index-topics ul{padding-left:21px;margin-top:12px}
    .faq-index-topics ul li{margin:9px 0}
    .faq-index a{text-underline-offset:3px;overflow-wrap:anywhere}
    .faq-entry{scroll-margin-top:18px}
    .faq-list{max-width:880px}
    .faq-item{max-width:none;background:white;border:1px solid #e8e2da;border-radius:12px;padding:0 20px;margin:12px 0}
    .faq-item summary{font-weight:750;padding:18px 0;cursor:pointer}
    .faq-item p{padding:0 0 18px;color:#5c574e;margin:0;max-width:760px}
    #respostas{scroll-margin-top:18px}
    @media(max-width:480px){.faq-item{padding:0 16px}}
  </style>
</BaseLayout>
