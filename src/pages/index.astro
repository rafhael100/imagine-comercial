---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVisual from '../components/HeroVisual.astro';
import QuickServiceRequest from '../components/QuickServiceRequest.astro';
import {guideGoals} from '../lib/public-service-guide.mjs';
import {encodeReviewedGoalFragment} from '../data/reviewed-goal-fragment.mjs';
import {buildServices as services} from '../lib/build-catalog.mjs';
const title='Sites, Landing Pages e gestão de anúncios | Imagine';
const description='Crie uma Onepage ou Landing Page, conheça sites profissionais e anuncie no Google e Meta. Compare preços, benefícios e escolha sua solução com a Imagine.';
const featured=services.filter(s=>['criacao-de-sites','landing-pages','gestao-google-ads'].includes(s.slug));
const additional=services.filter(s=>!featured.includes(s));
---
<BaseLayout title={title} description={description} pathname="/">
  <section class="hero hero-main">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">IMAGINE · SITES E MARKETING DIGITAL</p>
        <h1>Seu negócio mais bonito.<br/><span>Mais oportunidades.</span></h1>
        <p class="lead">Sites que valorizam sua marca. Anúncios para alcançar novos clientes. Escolha sua solução sem complicação.</p>
        <div class="cta-row">
          <a class="cta hero-cta" href="#solucoes">Quero um site <span aria-hidden="true">↗</span></a>
          <a class="cta cta-secondary hero-cta-secondary" href="#anuncios-performance">Quero anunciar <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-benefits" aria-label="Vantagens de escolher com a Imagine">
          <span>✓ Sem cadastro para explorar</span>
          <span>✓ Preços e opções claros</span>
          <span>✓ Atendimento especializado</span>
        </div>
      </div>
      <HeroVisual />
    </div>
  </section>
  <QuickServiceRequest />
  <section class="section home-quick-links shell" aria-labelledby="home-featured-title">
    <div class="quick-links-title">
      <div><p class="eyebrow">PRECISA DE AJUDA?</p><h2 id="home-featured-title">Vamos encontrar a solução certa.</h2></div>
      <a class="cta cta-secondary" href="/contato/">Falar com a Imagine <span aria-hidden="true">↗</span></a>
    </div>
    <div class="home-featured-grid">
      {featured.map(s=>(
        <div class="home-featured-mini">
          <span class="home-featured-mark" aria-hidden="true">✦</span>
          <strong>{s.label}</strong>
          <div class="home-featured-actions">
            <a href={'/servicos/'+s.slug+'/'} aria-label={'Conheça '+s.label}>Saiba mais</a>
            <a data-home-service-contact href={'/contato/#'+s.slug}
              aria-label={'Preparar contato sobre '+s.label}
              aria-describedby="home-featured-contact-notice">Preparar contato</a>
          </div>
        </div>
      ))}
    </div>
    <p id="home-featured-contact-notice" class="home-featured-contact-notice">O atalho prepara o assunto do contato, sem enviar um pedido.</p>
  </section>
  <section class="section section-soft home-decision" aria-labelledby="goal-start-heading">
    <div class="shell">
      <div class="home-decision-head"><div><p class="eyebrow">AINDA EM DÚVIDA?</p><h2 id="goal-start-heading">Comece pelo seu objetivo.</h2></div>
      <a class="text-link" href="/comparar-solucoes/">Comparar soluções <span aria-hidden="true">↗</span></a></div>
      <nav aria-label="Explorar soluções por objetivo">
        <ul class="home-goal-links">
          {guideGoals.map(goal=><li><a data-goal-deeplink href={'/servicos/'+encodeReviewedGoalFragment(goal.code)}>{goal.goal} <span aria-hidden="true">↗</span></a></li>)}
        </ul>
      </nav>
    </div>
  </section>
  <section class="section home-more shell" aria-labelledby="home-other-title">
    <div><p class="eyebrow">MAIS POSSIBILIDADES</p><h2 id="home-other-title">Outras soluções para seu negócio.</h2></div>
    <div class="home-more-links">
      {additional.map(s=><a href={'/servicos/'+s.slug+'/'}>{s.label} <span aria-hidden="true">↗</span></a>)}
    </div>
    <a class="text-link" href="/servicos/">Ver catálogo completo <span aria-hidden="true">↗</span></a>
  </section>
  <section class="section section-dark home-final">
    <div class="shell final-grid">
      <div><p class="eyebrow">BORA COMEÇAR?</p><h2>O próximo passo da sua empresa começa aqui.</h2></div>
      <div class="final-actions">
        <a class="cta" href="#solucoes">Escolher minha solução <span aria-hidden="true">↗</span></a>
        <a class="cta cta-secondary" href="/contato/">Conversar no WhatsApp</a>
      </div>
    </div>
  </section>
  <style>
    .hero-main{padding-block:clamp(44px,5vw,78px)}
    .hero-grid{display:grid;grid-template-columns:minmax(0,1.07fr) minmax(0,.93fr);gap:clamp(10px,3vw,44px);align-items:center}
    .hero-copy{min-width:0}
    .hero-copy h1{font-size:clamp(2.8rem,4.7vw,4.65rem);line-height:1.08;max-width:770px;letter-spacing:-.052em;margin:16px 0 17px}
    .hero-copy h1 span{color:#b95d00}
    .hero-copy .lead{max-width:565px;font-size:clamp(1rem,1.55vw,1.23rem);line-height:1.58}
    .hero-copy .cta-row{display:flex;align-items:center;gap:13px;flex-wrap:wrap;margin-top:28px}
    .hero-cta,.hero-cta-secondary{min-height:54px;display:inline-flex;align-items:center;justify-content:center;gap:16px;padding:13px 26px;border-radius:12px;font-weight:820}
    .hero-benefits{display:flex;flex-wrap:wrap;gap:8px 16px;margin-top:24px}
    .hero-benefits span{font-size:.84rem;color:#4c5149;font-weight:730;line-height:1.5}
    .home-quick-links{padding-block:clamp(32px,4.5vw,62px)}
    .quick-links-title,.home-decision-head{display:flex;justify-content:space-between;align-items:center;gap:24px}
    .quick-links-title h2,.home-decision-head h2,.home-more h2{font-size:clamp(1.75rem,2.5vw,2.5rem);letter-spacing:-.035em;line-height:1.17;margin:6px 0 0}
    .home-featured-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:24px}
    .home-featured-mini{min-width:0;background:#fff;border:1px solid #e8ded1;border-radius:13px;padding:15px;display:grid;grid-template-columns:30px minmax(0,1fr);align-items:center;gap:10px}
    .home-featured-mark{width:28px;height:28px;background:#fff1dd;color:#995000;display:grid;place-items:center;border-radius:8px}
    .home-featured-mini strong{font-size:.96rem;line-height:1.25}
    .home-featured-actions{display:flex;flex-wrap:wrap;grid-column:1/-1;gap:10px;align-items:center}
    .home-featured-actions a{display:inline-flex;align-items:center;min-height:44px;font-size:.84rem;font-weight:760;color:#884100}
    .home-featured-actions a[data-home-service-contact]{border:1px solid #d3b99d;background:#fff8ed;color:#884100;border-radius:9px;padding:10px 13px;text-decoration:none}
    .home-featured-actions a[data-home-service-contact]:hover{background:#fff0db}
    .home-featured-actions a:focus-visible{outline:3px solid #b45b00;outline-offset:3px}
    .home-featured-contact-notice{margin:12px 0 0;font-size:.78rem;color:#655f57}
    .home-decision{padding-block:clamp(40px,5vw,62px)}
    .home-goal-links{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,235px),1fr));gap:10px;list-style:none;padding:0;margin:20px 0 0}
    .home-goal-links a{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:48px;padding:12px 14px;background:#fff;border:1px solid #e6d9c9;border-radius:11px;color:#884100;font-size:.9rem;font-weight:740;text-decoration:none}
    .home-goal-links a:focus-visible{outline:3px solid #b45b00;outline-offset:3px}
    .home-more{padding-block:clamp(36px,4vw,56px)}
    .home-more-links{display:flex;flex-wrap:wrap;gap:10px;margin:18px 0}
    .home-more-links a{display:inline-flex;min-height:44px;align-items:center;gap:12px;padding:10px 14px;color:#7d4109;background:#fff8ee;border:1px solid #e8dccd;border-radius:100px;font-size:.86rem;font-weight:730;text-decoration:none}
    .home-final{padding-block:clamp(50px,6vw,80px)}
    .home-final .eyebrow{color:#f7b96e}
    .final-grid{display:flex;align-items:center;justify-content:space-between;gap:30px}
    .home-final h2{font-size:clamp(2rem,3.1vw,3rem);max-width:660px;margin:6px 0 0;line-height:1.15}
    .final-actions{display:flex;gap:12px;flex-wrap:wrap}
    .final-actions .cta{white-space:nowrap}
    @media(max-width:900px){.hero-grid{grid-template-columns:1fr}.hero-copy h1{max-width:710px}.home-featured-grid{grid-template-columns:1fr}.final-grid{display:block}.final-actions{margin-top:26px}}
    @media(max-width:560px){.hero-main{padding-block:28px}.hero-copy h1{font-size:clamp(2.5rem,10vw,3.7rem)}.hero-cta,.hero-cta-secondary{flex:1;min-width:min(100%,145px)}.quick-links-title,.home-decision-head{display:block}.quick-links-title .cta,.home-decision-head a{display:inline-flex;margin-top:13px}.home-featured-mini{padding:13px}.final-actions .cta{white-space:normal}}
  </style>
</BaseLayout>
