---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/articles.mjs';
import {articleContactIntent} from '../../lib/article-contact-intent.mjs';
import {createEditorialOutline} from '../../lib/editorial-outline.mjs';
import {relatedGuidesFor} from '../../data/related-articles.mjs';
import {comparisonForArticle} from '../../data/article-comparison-links.mjs';

export function getStaticPaths() {
  return articles.map(article=>({params:{slug:article.slug},props:{article}}));
}
const { article }=Astro.props;
const path='/conteudos/'+article.slug+'/';
const outline=createEditorialOutline(article);
const relatedGuides=relatedGuidesFor(article.slug);
const contactIntent=articleContactIntent(article);
const relevantComparison=comparisonForArticle(article.slug);
---
<BaseLayout title={article.title} description={article.description} pathname={path} articleTitle={article.heading} breadcrumb={[{label:'Conteúdos',path:'/conteudos/'},{label:article.heading,path}]}>
  <section class="hero"><div class="shell"><p class="eyebrow">{article.eyebrow}</p><h1>{article.heading}</h1><p class="lead">{article.intro}</p></div></section>
  <article class="section shell">
    <nav class="article-toc" aria-label="Sumário deste guia">
      <h2 id="guia-sumario" tabindex="-1">O que você vai encontrar</h2>
      <ol>
        {outline.map(section=><li><a href={'#'+section.id}>{section.heading}</a></li>)}
      </ol>
    </nav>
    {outline.map(section => (
      <section class="guide-section" id={section.id}>
        <h2>{section.heading}</h2>
        {section.paragraphs.map(p=><p>{p}</p>)}
        <div class="guide-section-actions">
          <a href="#guia-sumario" data-guide-return>Voltar ao sumário</a>
          <button type="button" data-guide-section-copy={section.id} hidden
            aria-label={'Copiar link da seção: '+section.heading}>
            Copiar link desta seção
          </button>
          <span role="status" aria-live="polite" aria-atomic="true"
            data-guide-share-status></span>
        </div>
      </section>
    ))}
    <hr style="border:0;border-top:1px solid #e8e2da;margin-block:32px" />
    <aside class="related-reading" aria-labelledby="related-reading-title">
      <h2 id="related-reading-title">Leia também</h2>
      <p>Outros guias que ajudam a aprofundar este assunto e comparar alternativas.</p>
      <ul class="bullets">
        {relatedGuides.map(guide=>(
          <li><span class="eyebrow">{guide.topic}</span> <a href={guide.href}>{guide.title}</a></li>
        ))}
      </ul>
    </aside>
    {relevantComparison && (
      <aside class="article-comparison" aria-labelledby="article-comparison-heading">
        <h2 id="article-comparison-heading">Compare os formatos do guia</h2>
        <p>Veja as duas soluções que acabamos de abordar lado a lado, com perguntas para orientar a escolha. Esta comparação não constitui proposta.</p>
        <a class="cta cta-secondary" data-article-comparison href={relevantComparison.href}>{relevantComparison.label}</a>
      </aside>
    )}
    <h2>Continue explorando</h2>
    <ul class="bullets">{article.links.map(link=><li><a href={link.href}>{link.label}</a></li>)}</ul>
  </article>
  <section class="section section-dark"><div class="shell"><h2>Precisa de orientação para seu projeto?</h2><p>Entre em contato com a equipe Imagine e conheça as soluções disponíveis.</p><div class="cta-row"><a class="cta" href={contactIntent.href}>{contactIntent.label}</a><a class="cta cta-secondary" href="/contato/">Orientação geral</a></div></div></section>
  <script>
    // F304: share only pre-rendered editorial heading IDs in this article.
    // No query strings, visitor input, network request or local persistence.
    if(navigator.clipboard?.writeText){
      for(const button of document.querySelectorAll<HTMLButtonElement>(
        '[data-guide-section-copy]')){
        const id=button.dataset.guideSectionCopy;
        const section=button.closest<HTMLElement>('.guide-section');
        const status=section?.querySelector<HTMLElement>('[data-guide-share-status]');
        if(!id||!section||section.id!==id||!status||
          !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(id))continue;
        button.hidden=false;
        button.addEventListener('click',async()=>{
          if(button.disabled)return;
          button.disabled=true;
          status.textContent='';
          const href=window.location.origin+window.location.pathname+'#'+id;
          try{
            await navigator.clipboard.writeText(href);
            status.textContent='Link desta seção copiado.';
          }catch{
            status.textContent='Não foi possível copiar. Use o link no sumário do guia.';
          }finally{
            button.disabled=false;
          }
        });
      }
    }
  </script>
  <style>
    .article-toc{padding:24px 28px;background:#f7f7f8;border:1px solid #e8e2da;border-radius:16px;margin-bottom:40px}
    .article-toc h2{font-size:1.5rem}
    #guia-sumario{scroll-margin-top:20px}
    .guide-section-actions{display:flex;align-items:center;flex-wrap:wrap;
      gap:10px 18px;margin:24px 0 0}
    .guide-section-actions a{display:inline-flex;align-items:center;min-height:44px;
      color:#884100;font-weight:750;text-underline-offset:4px}
    .guide-section-actions button{min-height:44px;padding:9px 14px;
      font:inherit;font-weight:750;border-radius:10px;
      border:1px solid #d3b99d;color:#884100;background:#fff8ed;cursor:pointer}
    .guide-section-actions button:hover{background:#fff0db}
    .guide-section-actions button:disabled{opacity:.65;cursor:wait}
    .guide-section-actions button[hidden]{display:none!important}
    .guide-section-actions :is(a,button):focus-visible{
      outline:3px solid #b45b00;outline-offset:3px}
    .guide-section-actions [role="status"]{font-size:.9rem;color:#655f57}
    @media print{.guide-section-actions{display:none!important}}
    .article-toc ol{padding-left:24px;margin-bottom:0;display:grid;gap:9px}
    .article-toc a{color:#884100;text-underline-offset:4px}
    .article-toc a:focus-visible{outline-offset:5px}
    .guide-section{scroll-margin-top:24px}
    .guide-section + .guide-section{margin-top:36px}
    .article-comparison{padding:24px;margin:16px 0 36px;border:1px solid #dcc8af;border-radius:16px;background:#fffaf4}
    .article-comparison h2{margin:0 0 10px}
    .article-comparison p{max-width:700px}
    .article-comparison a{margin-top:14px}
    .related-reading{border-left:4px solid #e49a35;background:#f7f7f8;padding:20px 24px;margin:12px 0 38px}
    .related-reading a{color:#884100;text-underline-offset:4px}
    .related-reading .eyebrow{display:block;font-size:.7rem}
  </style>
</BaseLayout>
