---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/articles.mjs';

export function getStaticPaths() {
  return articles.map(article=>({params:{slug:article.slug},props:{article}}));
}
const { article }=Astro.props;
const path='/conteudos/'+article.slug+'/';
---
<BaseLayout title={article.title} description={article.description} pathname={path} articleTitle={article.heading} breadcrumb={[{label:'Conteúdos',path:'/conteudos/'},{label:article.heading,path}]}>
  <div class="shell breadcrumbs"><a href="/">Início</a> / <a href="/conteudos/">Conteúdos</a> / <span aria-current="page">{article.heading}</span></div>
  <section class="hero"><div class="shell"><p class="eyebrow">{article.eyebrow}</p><h1>{article.heading}</h1><p class="lead">{article.intro}</p></div></section>
  <article class="section shell">
    {article.sections.map(([heading,...paragraphs]) => (
      <section><h2>{heading}</h2>{paragraphs.map(p=><p>{p}</p>)}</section>
    ))}
    <hr style="border:0;border-top:1px solid #dce6f2;margin-block:32px" />
    <h2>Continue explorando</h2>
    <ul class="bullets">{article.links.map(link=><li><a href={link.href}>{link.label}</a></li>)}</ul>
  </article>
  <section class="section section-dark"><div class="shell"><h2>Precisa de orientação para seu projeto?</h2><p>Entre em contato com a equipe Imagine e conheça as soluções disponíveis.</p><a class="cta" href="/contato/">Solicitar uma proposta</a></div></section>
</BaseLayout>
