---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildServices as services } from '../../lib/build-catalog.mjs';
import {guideGoals,guideForGoal} from '../../lib/public-service-guide.mjs';
import {serviceCatalogGroups,categoryForService} from '../../data/service-catalog-groups.mjs';
const initialGuide=guideForGoal(guideGoals[0].code);
---
<BaseLayout
  title="Soluções digitais para empresas | Imagine"
  description="Conheça soluções da Imagine para criação de sites, Landing Pages, Onepages e gestão de Google Ads e Meta Ads."
  pathname="/servicos/"
  breadcrumb={[{ label: 'Soluções', path: '/servicos/' }]}
>
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">Nossos serviços</p>
      <h1>Soluções digitais com objetivos comerciais definidos.</h1>
      <p class="lead">Conheça formatos de presença digital e gestão de mídia para empresas em diferentes momentos de crescimento.</p>
    </div>
  </section>
  <section class="section section-soft" aria-labelledby="service-guide-heading">
    <div class="shell">
      <p class="eyebrow">Escolha seu ponto de partida</p>
      <h2 id="service-guide-heading">Qual solução faz sentido para o seu objetivo?</h2>
      <p class="lead">Selecione um objetivo para conhecer os formatos que podem ajudar. Esta orientação não substitui uma proposta comercial.</p>
      <div class="service-guide">
        <label for="service-guide-goal">Meu objetivo principal</label>
        <select id="service-guide-goal" aria-controls="service-guide-results">
          {guideGoals.map(item => <option value={item.code}>{item.goal}</option>)}
        </select>
        <div id="service-guide-results" class="service-guide-results" aria-live="polite" aria-atomic="true">
          <h3>Caminhos para explorar</h3>
          <p id="service-guide-explanation">{initialGuide.explanation}</p>
          <ul id="service-guide-links">
            {initialGuide.services.map(item => (
              <li>
                <a data-service-guide-detail href={item.href}>Conhecer {item.label}</a>
                <a data-service-guide-contact href={item.contactHref}>Solicitar proposta sobre {item.label}</a>
              </li>
            ))}
          </ul>
          <a id="service-guide-compare" href="/comparar-solucoes/" hidden>
            Comparar essas duas soluções lado a lado
          </a>
        </div>
        <p class="service-guide-note">Todos os serviços continuam disponíveis abaixo. Os valores e as condições oficiais são confirmados na proposta.</p>
        <noscript>
          <div class="service-guide-fallback" aria-labelledby="service-guide-fallback-heading">
            <h3 id="service-guide-fallback-heading">Soluções por objetivo sem JavaScript</h3>
            <p>Seu objetivo pode ser consultado diretamente abaixo, sem depender do seletor interativo. Todas as soluções também continuam disponíveis no catálogo.</p>
            <ul>
              {guideGoals.map(goal=>(
                <li data-fallback-goal={goal.code}>
                  <strong>{goal.goal}</strong>
                  <ul>
                    {guideForGoal(goal.code).services.map(item=>(
                      <li><a href={item.href}>{item.label}</a></li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </div>
        </noscript>
      </div>
    </div>
  </section>
  <script>
    import {guideForGoal,guideGoals} from '../../lib/public-service-guide.mjs';
    import {encodeReviewedGoalFragment,decodeReviewedGoalFragment} from '../../data/reviewed-goal-fragment.mjs';
    // F58: local-only selection. Never collect or send any visitor input.
    const selector=document.querySelector<HTMLSelectElement>('#service-guide-goal');
    const explanation=document.querySelector<HTMLElement>('#service-guide-explanation');
    const links=document.querySelector<HTMLUListElement>('#service-guide-links');
    const compare=document.querySelector<HTMLAnchorElement>('#service-guide-compare');
    if(selector && explanation && links && compare){
      const renderGuide=()=>{
        const guide=guideForGoal(selector.value);
        explanation.textContent=guide.explanation;
        const suggestions=guide.services.map(item=>{
          const li=document.createElement('li');
          const detail=document.createElement('a');
          detail.href=item.href;
          detail.textContent='Conhecer '+item.label;
          detail.dataset.serviceGuideDetail='';
          const contact=document.createElement('a');
          contact.href=item.contactHref;
          contact.textContent='Solicitar proposta sobre '+item.label;
          contact.dataset.serviceGuideContact='';
          li.append(detail,contact);
          return li;
        });
        links.replaceChildren(...suggestions);
        compare.hidden=guide.comparisonHref===null;
        if(guide.comparisonHref!==null)compare.href=guide.comparisonHref;
        else compare.href='/comparar-solucoes/';
      };
      const restoreFromFragment=()=>{
        const code=decodeReviewedGoalFragment(window.location.hash);
        const localId=window.location.hash.slice(1);
        const isLocalAnchor=/^[a-z][a-z0-9-]{0,63}$/.test(localId)&&
          document.getElementById(localId)!==null;
        const cleanHash=code?encodeReviewedGoalFragment(code):
          isLocalAnchor?window.location.hash:'';
        // F205: remove unreviewed query/fragment, not legitimate anchors.
        if(window.location.search||window.location.hash!==cleanHash)
          window.history.replaceState(null,'',window.location.pathname+cleanHash);
        selector.value=code||guideGoals[0].code;
        renderGuide();
      };
      selector.addEventListener('change',()=>{
        // Replace the current entry with a fixed public goal token only.
        // Drop any inherited query data; no network request is made.
        const fragment=encodeReviewedGoalFragment(selector.value);
        window.history.replaceState(null,'',window.location.pathname+fragment);
        renderGuide();
      });
      window.addEventListener('hashchange',restoreFromFragment);
      window.addEventListener('popstate',restoreFromFragment);
      restoreFromFragment();
    }
    // F250: catalog filters only alter visibility of already-rendered,
    // reviewed services. No text input, PII, URL state, tracking or transport.
    const categoryControls=document.querySelector<HTMLElement>('#service-catalog-filters');
    const categoryButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-service-category]')];
    const categoryCards=[...document.querySelectorAll<HTMLElement>('[data-service-group]')];
    const categoryStatus=document.querySelector<HTMLElement>('#service-catalog-status');
    if(categoryControls&&categoryStatus&&categoryCards.length&&categoryButtons.length){
      const allowedCategories=new Set(categoryButtons.map(button=>button.dataset.serviceCategory));
      const applyCategory=(category:string)=>{
        if(!allowedCategories.has(category))return;
        let visible=0;
        for(const card of categoryCards){
          const match=category==='all'||card.dataset.serviceGroup===category;
          card.hidden=!match;
          if(match)visible++;
        }
        for(const button of categoryButtons)
          button.setAttribute('aria-pressed',String(button.dataset.serviceCategory===category));
        const title=categoryButtons.find(button=>button.dataset.serviceCategory===category)?.textContent?.trim();
        categoryStatus.textContent=category==='all'
          ?'Exibindo todos os '+visible+' serviços.'
          :'Exibindo '+visible+' '+(visible===1?'serviço':'serviços')+' de '+title+'.';
      };
      for(const button of categoryButtons)
        button.addEventListener('click',()=>applyCategory(button.dataset.serviceCategory||'all'));
      categoryControls.hidden=false;
      applyCategory('all');
    }
  </script>
  <style>
    .service-catalog-filters{display:flex;flex-wrap:wrap;gap:10px;margin:20px 0 14px}
    .service-catalog-filters[hidden],.service-catalog-grid [hidden]{display:none!important}
    .service-catalog-filters button{min-height:44px;padding:10px 16px;background:white;border:1px solid #d3b99d;border-radius:999px;color:#171b19;font:inherit;font-weight:700;cursor:pointer}
    .service-catalog-filters button[aria-pressed="true"]{background:#171b19;border-color:#171b19;color:white}
    .service-catalog-filters button:hover{border-color:#884100}
    .service-catalog-filters button:focus-visible{outline:3px solid #b45b00;outline-offset:3px}
    .service-catalog-status{color:#655f57;font-size:.93rem;margin:10px 0 20px}
    .service-catalog-grid{margin-top:12px}
    .service-card-actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;margin-top:16px}
    .service-card-actions a{display:inline-flex;align-items:center;min-height:44px;padding:8px 0;font-weight:750;line-height:1.4}
    .service-card-actions a[data-service-card-contact]{border:1px solid #d3b99d;border-radius:9px;background:#fff8ed;padding:10px 14px;text-decoration:none;color:#884100}
    .service-card-actions a[data-service-card-contact]:hover{background:#fff0db}
    .service-card-actions a:focus-visible{outline:3px solid #b45b00;outline-offset:3px}
    .service-catalog-disclosure{font-size:.88rem;color:#655f57;margin:2px 0 20px;max-width:780px}
    .service-guide{max-width:820px}
    .service-guide>label{display:block;font-weight:800;margin:26px 0 9px}
    .service-guide>select{width:min(100%,640px);padding:12px 14px;min-height:50px;border:1px solid #cdb59b;border-radius:10px;background:#fff;color:#171b19;font:inherit}
    .service-guide-results{margin-top:20px;padding:clamp(19px,3vw,28px);border:1px solid #e7ddd0;border-radius:16px;background:#fff}
    .service-guide-results h3{margin:0 0 12px}
    .service-guide-results p{margin:0}
    .service-guide-results ul{display:flex;flex-wrap:wrap;gap:14px 22px;margin:18px 0 0;padding-left:20px}
    .service-guide-results li{display:grid;gap:6px;max-width:340px}
    .service-guide-results li a{color:#884100;font-weight:750;text-underline-offset:4px}
    .service-guide-results [data-service-guide-contact]{font-weight:650}
    #service-guide-compare{display:inline-flex;margin-top:22px;min-height:48px;align-items:center;border-radius:9px;border:1px solid #d3b99d;padding:10px 15px;color:#884100;font-weight:800;text-underline-offset:3px}
    #service-guide-compare[hidden]{display:none!important}
    #service-guide-compare:focus-visible{outline:3px solid #b45b00;outline-offset:3px}
    .service-guide-note{font-size:.91rem;color:#655f57;margin-top:16px}
    .service-guide-fallback{background:#fff;border:1px solid #e5d7c6;border-radius:14px;padding:22px;margin-top:26px}
    .service-guide-fallback>ul{display:grid;gap:20px;list-style:none;padding:0}
    .service-guide-fallback>ul>li{border-top:1px solid #e8e2da;padding-top:12px}
    .service-guide-fallback ul ul{padding-left:22px;margin-top:6px}
    .service-guide-fallback a{color:#884100;text-underline-offset:3px;font-weight:700}
  </style>
  <section class="section shell" aria-labelledby="compare-invite-heading">
    <span class="kicker">Antes de contratar</span>
    <h2 id="compare-invite-heading">Quer comparar formatos lado a lado?</h2>
    <p class="lead">Veja quando considerar Onepage, site, Landing Page, modelo por assinatura ou campanhas Google e Meta, e quais perguntas ajudam a decidir.</p>
    <a class="cta cta-secondary" href="/comparar-solucoes/">Comparar as seis soluções</a>
  </section>
  <section class="section shell" aria-labelledby="service-catalog-title">
    <h2 id="service-catalog-title">Explore todas as soluções</h2>
    <p>Escolha uma área para ver os serviços relacionados ou mantenha todos visíveis.</p>
    <div id="service-catalog-filters" class="service-catalog-filters" role="group" aria-label="Filtrar serviços por área" hidden>
      {serviceCatalogGroups.map(group=>(
        <button type="button" data-service-category={group.code}
          aria-controls="service-catalog" aria-pressed={group.code==='all'?'true':'false'}>
          {group.label}
        </button>
      ))}
    </div>
    <p id="service-catalog-status" class="service-catalog-status" role="status" aria-live="polite" aria-atomic="true">Exibindo todos os {services.length} serviços.</p>
    <p id="service-catalog-contact-notice" class="service-catalog-disclosure">Preparar contato abre as opções públicas de atendimento com o serviço já selecionado. Nenhum dado é enviado por esse clique.</p>
    <div class="cards service-catalog-grid" id="service-catalog">
      {services.map(s => (
        <article class="card" data-service-group={categoryForService(s.slug)}>
          <p class="eyebrow">{s.eyebrow}</p>
          <h3>{s.label}</h3>
          <p>{s.intro}</p>
          <div class="service-card-actions">
            <a href={'/servicos/' + s.slug + '/'} aria-label={'Conhecer ' + s.label}>Conhecer serviço</a>
            <a data-service-card-contact href={'/contato/#'+s.slug}
              aria-label={'Preparar contato sobre '+s.label}
              aria-describedby="service-catalog-contact-notice">Preparar contato</a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="section section-dark">
    <div class="shell"><h2>Precisa de orientação?</h2><p>Podemos ajudar a escolher o formato adequado ao seu objetivo.</p><a class="cta" href="/contato/">Fale com a Imagine</a></div>
  </section>
</BaseLayout>
