---
import { toAbsoluteUrl } from '../data/services.mjs';
import { resolvePortalLoginLink } from '../lib/portal-login-link.mjs';
interface Props {
  title: string;
  description: string;
  pathname: string;
  noindex?: boolean;
  breadcrumb?: { label: string; path: string }[];
  serviceName?: string;
  articleTitle?: string;
}
const { title, description, pathname, noindex = false, breadcrumb = [], serviceName, articleTitle } = Astro.props;
const canonical = toAbsoluteUrl(pathname, Astro.site?.toString());
const socialType = articleTitle ? 'article' : 'website';
// O atalho é opcional e aparece somente se a URL passa pelo allowlist.
const portalLoginUrl = resolvePortalLoginLink(import.meta.env.PUBLIC_PORTAL_LOGIN_URL);
// F244: highlight a section without falsely claiming its parent link is the current page.
const serviceSectionActive = pathname.startsWith('/servicos/');
const contentSectionActive = pathname.startsWith('/conteudos/');
const guidanceSectionActive = pathname==='/como-funciona/'||pathname==='/perguntas-frequentes/';
// Evita encerramento de <script> em conteúdo futuramente proveniente de CMS.
const serializeJsonLd = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://imaginecomunicacao.com.br/#organization',
  name: 'Imagine Comunicação Digital',
  url: 'https://imaginecomunicacao.com.br/'
};
const webPage = {
  '@context': 'https://schema.org', '@type': 'WebPage',
  '@id': canonical + '#webpage',
  name: title, description, url: canonical, inLanguage: 'pt-BR',
  isPartOf: { '@type': 'WebSite', name: 'Imagine Comunicação Digital', url: 'https://imaginecomunicacao.com.br/' }
};
const bread = breadcrumb.length ? {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: toAbsoluteUrl('/') },
    ...breadcrumb.map((x, index) => ({ '@type': 'ListItem', position: index + 2, name: x.label, item: toAbsoluteUrl(x.path) }))
  ]
} : null;
const articleData = articleTitle ? {
  '@context': 'https://schema.org', '@type': 'Article',
  '@id': canonical + '#article', url: canonical, headline: articleTitle,
  inLanguage: 'pt-BR', mainEntityOfPage: canonical,
  publisher: { '@id': 'https://imaginecomunicacao.com.br/#organization' }
} : null;
const service = serviceName ? {
  '@context': 'https://schema.org', '@type': 'Service',
  '@id': canonical + '#service', url: canonical,
  name: serviceName, serviceType: serviceName, description,
  mainEntityOfPage: canonical,
  provider: { '@id': 'https://imaginecomunicacao.com.br/#organization' }
} : null;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171b19" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={socialType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Imagine Comunicação Digital" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {!noindex && <meta name="twitter:url" content={canonical} />}
    {!noindex && <script type="application/ld+json" set:html={serializeJsonLd(organization)} />}
    {!noindex && <script type="application/ld+json" set:html={serializeJsonLd(webPage)} />}
    {!noindex && bread && <script type="application/ld+json" set:html={serializeJsonLd(bread)} />}
    {!noindex && service && <script type="application/ld+json" set:html={serializeJsonLd(service)} />}
    {!noindex && articleData && <script type="application/ld+json" set:html={serializeJsonLd(articleData)} />}
    <style is:global>
      :root { --imagine-orange: #f9941d; --imagine-ink: #171b19; --imagine-soft: #f7f7f8; --imagine-line: #e8e8e8; --imagine-link: #884100; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: var(--imagine-ink); background: #fff; font-synthesis: none; scroll-behavior: smooth; }
      * { box-sizing: border-box; }
      body { margin: 0; line-height: 1.6; }
      a { color: inherit; }
      .shell { width: min(1160px, calc(100% - 36px)); margin-inline: auto; }
      .skip-link { position: absolute; top: -100px; left: 12px; padding: 10px; background: white; color: #152944; z-index: 99; }
      .skip-link:focus { top: 10px; }
      .header { display: flex; flex-wrap: wrap; gap: 18px; align-items: center; justify-content: space-between; padding-block: 17px; }
      .brand { display: inline-flex; align-items: center; min-height: 52px; max-width: 46%; text-decoration: none; color: var(--imagine-ink); } .brand img { display:block; width: min(190px, 100%); height: auto; max-height: 64px; object-fit: contain; object-position: left center; }
      nav { display: flex; flex-wrap: wrap; align-items: center; gap: clamp(12px, 2vw, 24px); font-size: .91rem; font-weight: 650; }
      nav a { text-decoration: none; }
      nav a:hover, nav a:focus-visible, .text-link:hover { text-decoration: underline; text-underline-offset: 4px; }
      nav a[aria-current="page"], .brand[aria-current="page"] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
      .nav-cta { border-radius: 9px; background: #fff0db; color: #793800; padding: 10px 16px; border: 1px solid #f5d3a4; }
      /* F150: native details for mobile navigation — works without JavaScript. */
      .mobile-menu { display: none; border: 0; padding: 0; max-width: none; margin: 0; }
      .mobile-menu summary { min-height: 48px; padding: 10px 16px; border: 1px solid #d3b99d; border-radius: 10px; color: var(--imagine-ink); background: #fff8ed; font-weight: 750; list-style: none; }
      .mobile-menu summary::-webkit-details-marker { display: none; }
      .mobile-menu summary::after { content: ' ▾'; }
      .mobile-menu[open] summary::after { content: ' ▴'; }
      .mobile-nav { position: absolute; z-index: 20; right: 0; top: calc(100% + 7px); width: min(320px, calc(100vw - 36px)); display: grid; gap: 2px; padding: 10px; border: 1px solid #ebdac8; border-radius: 14px; background: #fff; box-shadow: 0 16px 42px rgb(40 30 20 / 12%); }
      .mobile-nav a { display: block; min-height: 44px; padding: 10px 12px; border-radius: 8px; text-decoration: none; }
      .mobile-nav a:hover, .mobile-nav a:focus-visible { background: #fff1df; }
      .mobile-nav a[aria-current="page"], .mobile-nav a[data-section-active="true"] { background: #fff1df; text-decoration: underline; }
      .mobile-nav a[data-section-active="true"]:not([aria-current="page"]) { text-decoration-style: dotted; }
      nav[aria-label="Navegação principal"] a[data-section-active="true"] { color: #884100; box-shadow: inset 0 -2px 0 #f9941d; }
      .nav-help { position: relative; margin: 0; padding: 0; border: 0; max-width: none; }
      .nav-help > summary { display: flex; align-items: center; min-height: 44px; padding: 6px 2px; list-style: none; cursor: pointer; }
      .nav-help > summary::-webkit-details-marker { display: none; }
      .nav-help > summary::after { content: '⌄'; margin-left: 7px; font-weight: 800; }
      .nav-help[open] > summary::after { content: '⌃'; }
      .nav-help[data-section-active="true"] > summary { color: #884100; box-shadow: inset 0 -2px 0 #f9941d; }
      .nav-help-panel { position: absolute; z-index: 25; right: 0; top: calc(100% + 4px); width: 230px; display: grid; gap: 4px; padding: 9px; background: #fff; border: 1px solid #e8e2da; border-radius: 13px; box-shadow: 0 17px 32px rgb(35 30 22 / 12%); }
      .nav-help-panel a { display: flex; align-items: center; min-height: 44px; padding: 9px 12px; border-radius: 8px; }
      .nav-help-panel a:hover, .nav-help-panel a:focus-visible, .nav-help-panel a[aria-current="page"] { background: #fff1df; color: #884100; }
      .mobile-nav .nav-cta-mobile { background: #fff1df; font-weight: 800; color: #793800; }
      .eyebrow { font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: .14em; color: #874000; }
      h1 { font-size: clamp(2.4rem, 5.6vw, 4.9rem); line-height: 1.1; letter-spacing: -.065em; margin: 14px 0 20px; max-width: 930px; }
      h2 { font-size: clamp(1.6rem, 3.2vw, 2.5rem); line-height: 1.17; letter-spacing: -.045em; margin: 0 0 16px; }
      h3 { line-height: 1.35; font-size: 1.18rem; }
      p { max-width: 760px; }
      h1, h2, h3, p, summary { overflow-wrap: anywhere; hyphens: auto; }
      .lead { font-size: clamp(1.08rem, 1.6vw, 1.3rem); color: #4b5c74; line-height: 1.72; }
      .hero { padding-block: clamp(58px, 8vw, 112px); background: radial-gradient(ellipse at 92% 15%, #fff0db 0%, transparent 48%), #fff; }
      .hero .lead { max-width: 720px; }
      .section { padding-block: clamp(45px, 7vw, 85px); }
      .section-soft { background: var(--imagine-soft); }
      .section-dark { background: var(--imagine-ink); color: white; }
      .section-dark p { color: #e0dfdc; }
      .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 18px; margin-top: 32px; }
      .card { padding: clamp(22px, 2.5vw, 34px); border: 1px solid var(--imagine-line); background: white; border-radius: 17px; box-shadow: 0 14px 32px rgb(25 30 25 / 4%); }
      .card p { color: #526178; }
      .card a { color: var(--imagine-link); font-weight: 700; text-underline-offset: 4px; overflow-wrap: anywhere; }
      .card { min-width: 0; }
      .kicker { font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: var(--imagine-link); font-weight: 800; }
      .cta { display: inline-block; min-height: 48px; padding: 12px 22px; border-radius: 10px; background: var(--imagine-orange); color: var(--imagine-ink); font-weight: 750; text-decoration: none; text-align: center; border: 1px solid #d77700; }
      .cta:hover { background: #ffae47; }
      .cta-secondary { background: transparent; color: var(--imagine-link); border: 1px solid #d5a46b; }
      .cta-secondary:hover { background: #fff0db; }
      /* F158: secondary CTAs in dark sections need sufficient text contrast. */
      .section-dark .cta-secondary { color: #fff; border-color: #e1b779; }
      .section-dark .cta-secondary:hover { color: var(--imagine-ink); background: #fff0db; }
      .cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
      .bullets { padding-left: 22px; max-width: 740px; }
      .bullets li + li { margin-top: 9px; }
      .breadcrumbs { font-size: .88rem; color: #54647e; padding-top: 20px; }
      .breadcrumbs a { text-underline-offset: 3px; }
      details { border-bottom: 1px solid #d5deea; padding-block: 18px; max-width: 860px; }
      summary { cursor: pointer; font-weight: 700; }
      details p { color: #526178; }
      footer { padding-block: 34px; border-top: 1px solid var(--imagine-line); color: #526178; font-size: .9rem; }
      .footer-grid { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 14px; align-items: start; }
      .footer-grid a { text-underline-offset: 3px; }
      :focus-visible { outline: 3px solid #b45b00; outline-offset: 4px; }
      @media (max-width: 1020px) {
        .header { flex-wrap: nowrap; align-items: center; position: relative; }
        .header > nav[aria-label="Navegação principal"] { display: none; }
        .mobile-menu { display: block; position: relative; margin-left: auto; }
      }
      @media (max-width: 620px) { .cta-row a { width: 100%; } .section { padding-block: 42px; } }
      @media (prefers-reduced-motion: reduce) { :root { scroll-behavior: auto; } }
    </style>
  </head>
  <body>
    <a href="#conteudo" class="skip-link">Ir para o conteúdo</a>
    <header class="shell header">
      <a class="brand" href="/" aria-label="Imagine Comunicação Digital — Página inicial" aria-current={pathname==='/'?'page':undefined}><img src="/logo-imagine.png" alt="" width="190" decoding="async" fetchpriority="high" /></a>
      <nav aria-label="Navegação principal">
        <a href="/servicos/" aria-current={pathname==='/servicos/'?'page':undefined} data-section-active={serviceSectionActive?'true':undefined}>Soluções</a>
        <a href="/comparar-solucoes/" aria-current={pathname==='/comparar-solucoes/'?'page':undefined}>Comparar</a>
        <a href="/servicos/landing-pages/" aria-current={pathname==='/servicos/landing-pages/'?'page':undefined}>Landing Pages</a>
        <a href="/conteudos/" aria-current={pathname==='/conteudos/'?'page':undefined} data-section-active={contentSectionActive?'true':undefined}>Conteúdos</a>
        <details class="nav-help" data-section-active={guidanceSectionActive?'true':undefined}>
          <summary>Orientações</summary>
          <div class="nav-help-panel">
            <a href="/como-funciona/" aria-current={pathname==='/como-funciona/'?'page':undefined}>Como funciona</a>
            <a href="/perguntas-frequentes/" aria-current={pathname==='/perguntas-frequentes/'?'page':undefined}>Perguntas frequentes</a>
          </div>
        </details>
        <a href="/sobre/" aria-current={pathname==='/sobre/'?'page':undefined}>Sobre</a>
        <a href="/contato/" aria-current={pathname==='/contato/'?'page':undefined}>Contato</a>
        {portalLoginUrl && <a class="nav-cta" href={portalLoginUrl} rel="noopener">Portal do Cliente</a>}
      </nav>
      <details class="mobile-menu">
        <summary>Menu</summary>
        <nav class="mobile-nav" aria-label="Navegação móvel">
          <a href="/servicos/" aria-current={pathname==='/servicos/'?'page':undefined} data-section-active={serviceSectionActive?'true':undefined}>Soluções</a>
          <a href="/comparar-solucoes/" aria-current={pathname==='/comparar-solucoes/'?'page':undefined}>Comparar</a>
          <a href="/servicos/landing-pages/" aria-current={pathname==='/servicos/landing-pages/'?'page':undefined}>Landing Pages</a>
          <a href="/conteudos/" aria-current={pathname==='/conteudos/'?'page':undefined} data-section-active={contentSectionActive?'true':undefined}>Conteúdos</a>
          <a href="/como-funciona/" aria-current={pathname==='/como-funciona/'?'page':undefined}>Como funciona</a>
          <a href="/perguntas-frequentes/" aria-current={pathname==='/perguntas-frequentes/'?'page':undefined}>Perguntas frequentes</a>
          <a href="/sobre/" aria-current={pathname==='/sobre/'?'page':undefined}>Sobre</a>
          <a href="/contato/" aria-current={pathname==='/contato/'?'page':undefined}>Contato</a>
          {portalLoginUrl && <a class="nav-cta-mobile" href={portalLoginUrl} rel="noopener">Portal do Cliente</a>}
        </nav>
      </details>
    </header>
    <main id="conteudo"><slot /></main>
    <footer>
      <div class="shell footer-grid">
        <div><strong>Imagine Comunicação Digital</strong><div>Sites, tecnologia e performance digital.</div></div>
        <div><a href="/servicos/">Soluções</a> · <a href="/como-funciona/">Como funciona</a> · <a href="/perguntas-frequentes/">Perguntas frequentes</a> · <a href="/sobre/">Sobre</a> · <a href="/contato/">Contato</a></div>
        <div>© {new Date().getFullYear()} Imagine Comunicação Digital.</div>
      </div>
    </footer>
  </body>
</html>
