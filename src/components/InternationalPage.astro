---
import BaseLayout from '../layouts/InternationalLayout.astro';
import InternationalBudgetCalculator from './InternationalBudgetCalculator.astro';
import {translations,intlPath,INTERNATIONAL_SECTIONS} from '../data/i18n.mjs';
import {contactChannels} from '../data/contact-channels.mjs';
import {internationalArticles,INTERNATIONAL_ARTICLE_SLUGS} from '../data/i18n-articles.mjs';
interface Props { locale:'en'|'es'; section:string; }
const {locale,section}=Astro.props;
if(!INTERNATIONAL_SECTIONS.includes(section))throw new Error('Unapproved localized route');
const copy=translations[locale];
const paths={
 home:intlPath(locale),services:intlPath(locale,'services'),
 contact:intlPath(locale,'contact'),how:intlPath(locale,'how-it-works'),
 faq:intlPath(locale,'faq'),about:intlPath(locale,'about'),
 compare:intlPath(locale,'compare'),articles:intlPath(locale,'articles')
};
const isService=section.startsWith('services/');
const isArticle=section.startsWith('articles/');
const articleSlug=isArticle?section.slice('articles/'.length):null;
const article=articleSlug?internationalArticles[locale][articleSlug]:null;
if(isArticle&&!article)throw new Error('Unapproved international article');
const articleList=INTERNATIONAL_ARTICLE_SLUGS.map(slug=>({slug,...internationalArticles[locale][slug]}));
const articlesLabel=locale==='en'?'Guides & insights':'Guías y contenidos';
const serviceSlug=isService?section.slice('services/'.length):null;
const service=serviceSlug?copy.services[serviceSlug]:null;
if(isService&&!service)throw new Error('Unapproved international service');
const serviceList=Object.entries(copy.services).map(([slug,value])=>({slug,...value}));
const pageLabel={
 '':copy.nav.home,services:copy.nav.services,compare:copy.nav.compare,
 'budget-calculator':locale==='en'?'Advertising budget calculator':'Calculadora de inversión publicitaria',
 'how-it-works':copy.nav.how,faq:copy.nav.faq,about:copy.nav.about,
 contact:copy.nav.contact,articles:articlesLabel
};
const currentLabel=service?.label??article?.heading??pageLabel[section];
const langSuffix=locale==='en'?'English':'Español';
const title=article?.title??(section===''?
  (locale==='en'?'Professional websites & digital marketing | Imagine':'Sitios web y marketing digital | Imagine'):
  `${currentLabel} | Imagine Comunicação Digital · ${langSuffix}`);
const intro=article?.intro??(section==='articles'?
  (locale==='en'?'Explore practical guides on websites, advertising and search visibility for businesses.':
    'Explora guías prácticas sobre sitios web, publicidad y posicionamiento para empresas.'):
  service?.intro??
  (section==='about'?copy.about.intro:
    section==='contact'?copy.contact.intro:
    section==='budget-calculator'?(locale==='en'?'Estimate a starting advertising budget for Google, Meta and ChatGPT Ads, without signup.':'Calcula una inversión inicial para Google, Meta y ChatGPT Ads, sin registro.'):
    section==='compare'?copy.compare.intro:
    section==='how-it-works'?copy.headings.processIntro:
    section==='faq'?copy.headings.note:
    copy.headings.servicesIntro));
const metaCopy=section==='' ? copy.hero.intro : intro+' '+
  (locale==='en'?'Learn about Imagine digital services and request a tailored proposal.':
    'Conoce los servicios digitales de Imagine y solicita una propuesta a medida.');
// Keep each description unique, readable, and within the existing SEO guard.
const description=metaCopy.length>200
  ?metaCopy.slice(0,198).replace(/\s+\S*$/,'').trim()+'.'
  :metaCopy;
const crumbs=section===''?[]:(isService?
  [{label:copy.nav.services,path:paths.services},{label:service.label,path:intlPath(locale,section)}]:
  isArticle?[{label:articlesLabel,path:paths.articles},{label:article.heading,path:intlPath(locale,section)}]:
  [{label:currentLabel,path:intlPath(locale,section)}]);
const serviceLink=slug=>intlPath(locale,'services/'+slug);
---
<BaseLayout title={title} description={description} pathname={intlPath(locale,section)} locale={locale} breadcrumb={crumbs} articleTitle={article?.heading}>
  {section==='' && (
    <>
      <section class="hero" aria-labelledby="international-main-title">
        <div class="shell">
          <p class="eyebrow">{copy.hero.eyebrow}</p>
          <h1 id="international-main-title">{copy.hero.title}</h1>
          <p class="lead">{copy.hero.intro}</p>
          <div class="cta-row">
            <a class="cta" href={paths.contact}>{copy.hero.primary}</a>
            <a class="cta cta-secondary" href={paths.services}>{copy.hero.secondary}</a>
          </div>
          <p class="intl-quiet">{copy.hero.support}</p>
        </div>
      </section>
      <section class="section section-soft">
        <div class="shell">
          <p class="kicker">{copy.nav.services}</p>
          <h2>{copy.headings.services}</h2>
          <p>{copy.headings.servicesIntro}</p>
          <div class="cards intl-card-grid">
            {serviceList.map(item=>(
              <article class="card">
                <p class="eyebrow">{item.eyebrow}</p>
                <h3>{item.label}</h3>
                <p>{item.intro}</p>
                <a href={serviceLink(item.slug)} aria-label={copy.actions.learn+': '+item.label}>{copy.actions.learn}</a>
              </article>
            ))}
          </div>
          <div class="cta-row"><a class="text-link" href={paths.services}>{copy.actions.all}</a></div>
        </div>
      </section>
      <section class="section shell">
        <p class="kicker">{copy.nav.how}</p>
        <h2>{copy.headings.process}</h2>
        <p>{copy.headings.processIntro}</p>
        <div class="cards intl-stage-grid">
          {copy.stages.map(([label,detail],index)=>(
            <article class="card"><p class="eyebrow">{String(index+1).padStart(2,'0')}</p><h3>{label}</h3><p>{detail}</p></article>
          ))}
        </div>
        <div class="cta-row"><a class="cta cta-secondary" href={paths.how}>{copy.nav.how}</a></div>
      </section>
      <section class="section section-dark">
        <div class="shell">
          <h2>{copy.headings.contact}</h2>
          <p>{copy.about.intro}</p>
          <a class="cta" href={paths.contact}>{copy.actions.contact}</a>
        </div>
      </section>
    </>
  )}
  {section==='services' && (
    <>
      <section class="hero"><div class="shell"><p class="eyebrow">{copy.nav.services}</p><h1>{copy.headings.services}</h1><p class="lead">{copy.headings.servicesIntro}</p></div></section>
      <section class="section shell">
        <div class="cards intl-card-grid">
          {serviceList.map(item=>(
            <article class="card"><p class="eyebrow">{item.eyebrow}</p><h2 class="intl-card-title">{item.label}</h2><p>{item.intro}</p>
              <a href={serviceLink(item.slug)}>{copy.actions.learn}</a>
            </article>
          ))}
        </div>
        <div class="cta-row"><a class="cta" href={paths.contact}>{copy.actions.contact}</a><a class="cta cta-secondary" href={paths.compare}>{copy.nav.compare}</a></div>
      </section>
    </>
  )}
  {isService && service && (
    <>
      <section class="hero"><div class="shell"><p class="eyebrow">{service.eyebrow}</p><h1>{service.label}</h1><p class="lead">{service.intro}</p><div class="cta-row"><a class="cta" href={paths.contact}>{copy.actions.contact}</a><a class="cta cta-secondary" href={paths.services}>{copy.actions.back}</a></div></div></section>
      <section class="section shell"><h2>{locale==='en'?'How we approach this service':'Cómo abordamos este servicio'}</h2><p class="lead">{service.approach}</p>
        <div class="cards intl-card-grid">{service.details.map(([label,detail])=>(<article class="card"><h3>{label}</h3><p>{detail}</p></article>))}</div>
      </section>
      <section class="section section-soft"><div class="shell"><h2>{copy.nav.faq}</h2><details><summary>{service.question[0]}</summary><p>{service.question[1]}</p></details><p class="intl-quiet">{copy.headings.note}</p></div></section>
      <section class="section shell"><h2>{copy.headings.contact}</h2><p>{copy.contact.intro}</p><a class="cta" href={paths.contact}>{copy.actions.contact}</a></section>
    </>
  )}
  {section==='budget-calculator' && <InternationalBudgetCalculator locale={locale} />}
  {section==='compare' && (
    <>
      <section class="hero"><div class="shell"><p class="eyebrow">{copy.nav.compare}</p><h1>{copy.headings.compare}</h1><p class="lead">{copy.compare.intro}</p></div></section>
      <section class="section shell"><div class="cards intl-card-grid">
        {copy.compare.pairs.map(([label,detail],index)=>(<article class="card"><h2 class="intl-card-title">{label}</h2><p>{detail}</p>
          <a href={serviceLink(['onepage','landing-pages','criacao-de-sites','gestao-google-ads'][index])}>{copy.actions.learn}</a></article>))}
      </div><p>{copy.headings.note}</p><a class="cta" href={paths.contact}>{copy.actions.contact}</a></section>
    </>
  )}
  {section==='how-it-works' && (
    <>
      <section class="hero"><div class="shell"><p class="eyebrow">{copy.nav.how}</p><h1>{copy.headings.process}</h1><p class="lead">{copy.headings.processIntro}</p></div></section>
      <section class="section shell"><div class="cards intl-stage-grid">
        {copy.stages.map(([label,detail],index)=>(<article class="card"><p class="eyebrow">{String(index+1).padStart(2,'0')}</p><h2 class="intl-card-title">{label}</h2><p>{detail}</p></article>))}
      </div><p>{copy.headings.note}</p><a class="cta" href={paths.contact}>{copy.actions.contact}</a></section>
    </>
  )}
  {section==='faq' && (
    <>
      <section class="hero"><div class="shell"><p class="eyebrow">{copy.nav.faq}</p><h1>{copy.headings.faq}</h1><p class="lead">{copy.headings.note}</p></div></section>
      <section class="section shell">
        {copy.faq.map(([question,answer])=>(<details><summary>{question}</summary><p>{answer}</p></details>))}
        <div class="cta-row"><a class="cta" href={paths.contact}>{copy.actions.contact}</a></div>
      </section>
    </>
  )}
  {section==='about' && (
    <>
      <section class="hero"><div class="shell"><p class="eyebrow">{copy.nav.about}</p><h1>{copy.headings.about}</h1><p class="lead">{copy.about.intro}</p><div class="cta-row"><a class="cta" href={paths.services}>{copy.actions.all}</a><a class="cta cta-secondary" href={paths.contact}>{copy.actions.contact}</a></div></div></section>
      <section class="section shell"><div class="cards intl-card-grid">{copy.about.values.map(([label,detail])=>(<article class="card"><h2 class="intl-card-title">{label}</h2><p>{detail}</p></article>))}</div></section>
    </>
  )}
  {section==='articles' && (
    <>
      <section class="hero"><div class="shell">
        <p class="eyebrow">{articlesLabel}</p>
        <h1>{locale==='en'?'Guides to make better digital decisions':'Guías para tomar mejores decisiones digitales'}</h1>
        <p class="lead">{intro}</p>
      </div></section>
      <section class="section shell">
        <h2>{locale==='en'?'Explore our guides':'Explora nuestras guías'}</h2>
        <div class="cards intl-card-grid">
          {articleList.map(item=>(
            <article class="card"><p class="eyebrow">{item.eyebrow}</p>
              <h3>{item.heading}</h3><p>{item.intro}</p>
              <a href={intlPath(locale,'articles/'+item.slug)}
                aria-label={locale==='en'?'Read guide: '+item.heading:'Leer guía: '+item.heading}>
                {locale==='en'?'Read the guide':'Leer la guía'}
              </a>
            </article>
          ))}
        </div>
        <div class="cta-row"><a class="cta cta-secondary" href={paths.services}>{copy.actions.all}</a></div>
      </section>
    </>
  )}
  {isArticle && article && (
    <>
      <section class="hero"><div class="shell">
        <p class="eyebrow">{article.eyebrow}</p>
        <h1>{article.heading}</h1>
        <p class="lead">{article.intro}</p>
      </div></section>
      <article class="section shell">
        <nav class="intl-article-toc" aria-label={locale==='en'?'Guide sections':'Secciones de la guía'}>
          <h2>{locale==='en'?'In this guide':'En esta guía'}</h2>
          <ol>{article.sections.map(([heading],i)=>(
            <li><a href={'#section-'+(i+1)}>{heading}</a></li>
          ))}</ol>
        </nav>
        {article.sections.map(([heading,first,second],i)=>(
          <section class="intl-article-section" id={'section-'+(i+1)}>
            <h2>{heading}</h2>
            <p>{first}</p><p>{second}</p>
          </section>
        ))}
        <aside class="intl-article-next">
          <h2>{locale==='en'?'Keep exploring':'Sigue explorando'}</h2>
          <p>{copy.headings.note}</p>
          <div class="cta-row">
            <a class="cta cta-secondary" href={paths.articles}>{articlesLabel}</a>
            <a class="cta cta-secondary" href={paths.services}>{copy.actions.all}</a>
            <a class="cta" href={paths.contact}>{copy.actions.contact}</a>
          </div>
        </aside>
      </article>
    </>
  )}
  {section==='contact' && (
    <>
      <section class="hero"><div class="shell"><p class="eyebrow">{copy.nav.contact}</p><h1>{copy.headings.contact}</h1><p class="lead">{copy.contact.intro}</p></div></section>
      <section class="section shell">
        <div class="cards intl-card-grid">
          <article class="card"><h2 class="intl-card-title">{copy.actions.contactByEmail}</h2><p>{contactChannels.email}</p><a href={'mailto:'+contactChannels.email}>{copy.actions.contactByEmail}</a></article>
          <article class="card"><h2 class="intl-card-title">WhatsApp</h2><p>{contactChannels.whatsappDisplay}</p><a href={contactChannels.whatsappBaseHref} target="_blank" rel="noopener noreferrer" aria-label={copy.actions.contactWhatsApp+' — '+copy.accessibility.external}>{copy.actions.contactWhatsApp}</a></article>
        </div>
        <p class="intl-quiet">{copy.contact.noSend}</p><p class="intl-quiet">{copy.contact.safety}</p>
        <p class="intl-quiet">{copy.footer.note}</p>
        <div class="cta-row"><a class="cta cta-secondary" href={paths.services}>{copy.actions.all}</a></div>
      </section>
    </>
  )}
  <style>
    .intl-quiet{margin-top:24px;color:#62594d;font-size:.92rem}
    .intl-card-grid{grid-template-columns:repeat(auto-fit,minmax(min(100%,270px),1fr))}
    .intl-stage-grid{grid-template-columns:repeat(auto-fit,minmax(min(100%,225px),1fr))}
    .intl-card-title{font-size:1.35rem;line-height:1.3;margin-bottom:12px}
    .section-dark .intl-quiet{color:#e0dfdc}
    .card h2,.card h3{overflow-wrap:anywhere}
    .card a{display:inline-flex;min-height:44px;align-items:center}
    .intl-article-toc{padding:24px 28px;border:1px solid #e8e2da;border-radius:16px;background:#f7f7f8;margin-bottom:38px;max-width:900px}
    .intl-article-toc h2{font-size:1.4rem}
    .intl-article-toc ol{display:grid;gap:8px;padding-left:22px}
    .intl-article-toc a{color:#884100;min-height:44px;display:inline-flex;align-items:center}
    .intl-article-section{max-width:860px;scroll-margin-top:24px;margin-top:36px}
    .intl-article-section p{max-width:810px}
    .intl-article-next{margin-top:44px;padding:22px;background:#f7f7f8;border-radius:16px}
  </style>
</BaseLayout>
