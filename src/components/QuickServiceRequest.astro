---
import {buildServices as services} from '../lib/build-catalog.mjs';
import {composeCuratedContactLinks} from '../data/contact-objectives.mjs';
import {contactWhatsAppUrl} from '../data/contact-channels.mjs';
import {REVIEWED_OFFERS,reviewedPrivatePortalUrl} from '../../ops/review/purchase/private-portal-handoff-policy.mjs';
// A commercial preview must not expose the private Portal to public visitors.
const privatePortalBuild=process.env.GITHUB_ACTIONS==='true' && process.env.IMAGINE_ASTRO_PRIVATE_PORTAL_PREVIEW==='1';
const portalPreviewHref=(slug:string):string=>privatePortalBuild && Object.hasOwn(REVIEWED_OFFERS,slug)
  ? reviewedPrivatePortalUrl(slug) : '';
const offerCopy:Record<string,{tag:string,outcome:string,forWhom:string,includes:string[],price:string,media?:string,availability?:string}>={
 'criacao-de-sites':{
  tag:'Presença completa',outcome:'Uma vitrine profissional para sua empresa na internet.',
  forWhom:'Para negócios que precisam apresentar vários serviços, diferenciais e formas de contato.',
  includes:['Estrutura de páginas organizada','Visual adaptado a celular e computador','Fundamentos de SEO e navegação'],
  price:'Formato, implantação e condições definidos na proposta.'
 },
 'landing-pages':{
  tag:'Foco em conversão',outcome:'Uma página feita para apresentar uma oferta e orientar a próxima ação.',
  forWhom:'Para campanhas, lançamentos e produtos que precisam de uma mensagem objetiva.',
  includes:['Uma oferta em destaque','Conteúdo e chamadas para ação','Layout responsivo e mensuração planejada'],
  price:'Escopo, implantação e condições apresentados antes da contratação.'
 },
 'onepage':{
  tag:'Comece com o essencial',outcome:'Tudo o que seu cliente precisa saber em uma única página.',
  forWhom:'Para quem busca começar com apresentação clara e contatos acessíveis.',
  includes:['Seções essenciais do negócio','Serviços e canais de contato','Leitura simples em qualquer tela'],
  price:'Implantação e condições informadas na etapa comercial.'
 },
 'sites-por-assinatura':{
  tag:'Modelo de assinatura',outcome:'Um site com implantação e acompanhamento em um modelo recorrente.',
  forWhom:'Para empresas que preferem organizar a presença digital como serviço contínuo.',
  includes:['Escopo de implantação definido','Etapas e aprovações organizadas','Condições de recorrência explicadas antes do aceite'],
  price:'Implantação, mensalidade e vigência dependem do plano confirmado.'
 },
 'gestao-google-ads':{
  tag:'Pessoas buscando soluções',outcome:'Apareça para pessoas que procuram produtos e serviços como os seus.',
  forWhom:'Para negócios com demanda de busca e uma oferta pronta para receber contatos.',
  includes:['Planejamento de palavras e intenção','Estrutura e acompanhamento de campanhas','Medição e ajustes orientados por dados'],
  price:'Gestão: 20% da mídia efetiva, mínimo R$ 170/mês por canal. Ativação única: R$ 490.',
  media:'Mídia: mínimo Imagine R$ 1.000/mês · planejamento recomendado a partir de R$ 1.500.'
 },
 'gestao-meta-ads':{
  tag:'Instagram + Facebook',outcome:'Mostre sua oferta para públicos relevantes no Instagram e Facebook.',
  forWhom:'Para quem deseja despertar interesse, divulgar novidades e desenvolver demanda.',
  includes:['Definição de objetivo e públicos','Planejamento de mensagens e formatos','Acompanhamento de campanhas'],
  price:'Gestão: 20% da mídia efetiva, mínimo R$ 170/mês no canal Meta. Ativação única: R$ 490.',
  media:'Mídia: mínimo Imagine R$ 700/mês · planejamento recomendado a partir de R$ 1.000.'
 },
 'gestao-chatgpt-ads':{
  tag:'Canal em validação',outcome:'Conheça as possibilidades de mídia patrocinada no ChatGPT.',
  forWhom:'Para empresas interessadas em avaliar um novo canal, com piloto condicionado a elegibilidade.',
  includes:['Estudo de viabilidade','Planejamento de um possível piloto','Acompanhamento sujeito às regras da plataforma'],
  price:'Parâmetros indicativos da Imagine; contratação ainda indisponível.',
  media:'Piso de planejamento Imagine: R$ 1.200 de mídia/mês · recomendado a partir de R$ 1.800.',
  availability:'Canal não habilitado para checkout. Disponibilidade e aprovação dependem da plataforma.'
 }
};
const groups=[
 {id:'sites-paginas',category:'01 · Sites e páginas',heading:'Sua empresa bem apresentada, com o formato certo.',intro:'Do primeiro site a uma página de campanha: escolha o que seu negócio precisa comunicar.',slugs:['onepage','landing-pages','criacao-de-sites','sites-por-assinatura']},
 {id:'anuncios-performance',category:'02 · Anúncios e performance',heading:'Leve sua oferta a quem pode se interessar.',intro:'Compare canais e entenda o investimento antes de decidir. A mídia é paga diretamente a cada plataforma.',slugs:['gestao-google-ads','gestao-meta-ads','gestao-chatgpt-ads']}
];
const offeredIds=new Set(services.map(service=>service.slug));
if(Object.keys(offerCopy).some(slug=>!offeredIds.has(slug)) ||
  groups.flatMap(group=>group.slugs).some(slug=>!offeredIds.has(slug)) ||
  new Set(groups.flatMap(group=>group.slugs)).size!==services.length)
  throw new Error('Commercial showcase catalog requires editorial review');
const bySlug=Object.fromEntries(services.map(service=>[service.slug,service]));
---
<section class="quick-hire section" id="solucoes" aria-labelledby="quick-hire-title">
 <div class="shell">
  <div class="showcase-heading">
   <div>
    <p class="eyebrow">Soluções para o seu momento</p>
    <h2 id="quick-hire-title">Escolha pelo que você quer conquistar. Depois veja como contratar.</h2>
    <p>Sem termos complicados: cada solução explica para quem serve, o que está incluído e como funciona o investimento.</p>
   </div>
   <a class="showcase-compare" href="/comparar-solucoes/">Ainda não sabe qual escolher? Compare as soluções <span aria-hidden="true">↗</span></a>
  </div>
  <nav class="path-nav" aria-label="Escolha seu caminho">
   <a href="#sites-paginas"><span class="path-icon" aria-hidden="true">▣</span><span><strong>Quero um site ou página</strong><small>Apresentar minha empresa ou divulgar uma oferta</small></span><span aria-hidden="true">↗</span></a>
   <a href="#anuncios-performance"><span class="path-icon" aria-hidden="true">↗</span><span><strong>Quero atrair mais oportunidades</strong><small>Google, Instagram, Facebook e novos canais</small></span><span aria-hidden="true">↗</span></a>
   <a href="/calculadora-de-anuncios/"><span class="path-icon" aria-hidden="true">≋</span><span><strong>Quero saber quanto investir</strong><small>Simule uma verba de mídia antes de conversar</small></span><span aria-hidden="true">↗</span></a>
  </nav>
  {groups.map(group=>(
   <div class="offer-group" id={group.id}>
    <div class="offer-group-heading">
     <p class="eyebrow">{group.category}</p>
     <h3>{group.heading}</h3>
     <p>{group.intro}</p>
    </div>
    <div class="quick-hire-grid">
     {group.slugs.map(slug=>{
      const service=bySlug[slug],detail=offerCopy[slug];
      const preview=portalPreviewHref(slug);
      const cta=slug==='gestao-chatgpt-ads'?'Conversar sobre disponibilidade':preview?'Escolher e continuar':'Quero conhecer minha proposta';
      return (
       <article class="quick-hire-card" data-quick-hire={service.slug}>
        <div class="offer-top"><span class="offer-tag">{detail.tag}</span><span class="offer-arrow" aria-hidden="true">↗</span></div>
        <h4>{service.label}</h4>
        <p class="offer-outcome">{detail.outcome}</p>
        <p class="offer-for"><strong>Indicado para:</strong> {detail.forWhom}</p>
        <p class="offer-list-title">O que esta solução contempla</p>
        <ul class="offer-includes">{detail.includes.map(item=><li>{item}</li>)}</ul>
        <div class="offer-finance">
         <p class="offer-price">{detail.price}</p>
         {detail.media && <p class="offer-media">{detail.media}</p>}
         {detail.availability && <p class="offer-availability">{detail.availability}</p>}
        </div>
        <div class="quick-hire-links">
         <a class="quick-hire-details" href={'/servicos/'+service.slug+'/'}>Entender este serviço</a>
         <a class="cta quick-hire-action" data-quick-hire-action
            href={preview || contactWhatsAppUrl(composeCuratedContactLinks(service.slug).message)}
            target={preview ? undefined : '_blank'}
            rel={preview ? 'noreferrer nofollow' : 'noopener noreferrer'}
            aria-label={preview ? 'Abrir escolha privada de contratação: '+service.label : 'Conversar sobre '+service.label+' no WhatsApp'}
            aria-describedby="quick-hire-notice">{cta} <span aria-hidden="true">↗</span></a>
        </div>
       </article>
      );
     })}
    </div>
   </div>
  ))}
  <div class="checkout-preview" id="fluxo-comercial" aria-labelledby="checkout-flow-title">
   <div><p class="eyebrow">Compra sem burocracia</p><h3 id="checkout-flow-title">Primeiro você escolhe. O cadastro fica para o final.</h3>
    <p>O caminho planejado é simples: selecionar a solução, ajustar opções, conferir a proposta e somente então informar os dados necessários ao fechamento.</p></div>
   <ol>
    <li><span>01</span><strong>Escolha a solução</strong><small>Comece pelo serviço que resolve sua necessidade.</small></li>
    <li><span>02</span><strong>Personalize</strong><small>Defina formato ou canais elegíveis, conforme o serviço.</small></li>
    <li><span>03</span><strong>Confira valores</strong><small>Veja implantação, mídia e mensalidade em campos separados.</small></li>
    <li><span>04</span><strong>Conclua a contratação</strong><small>Dados e pagamento somente depois da escolha e revisão.</small></li>
   </ol>
  </div>
  <p id="quick-hire-notice" class="quick-hire-notice">{privatePortalBuild
   ? 'Prévia privada de contratação: apenas ofertas homologáveis abrem o Portal de teste; outros serviços seguem para atendimento. Nenhum cadastro, contrato ou pagamento real é iniciado.'
   : 'Nesta prévia pública, o botão de interesse abre o WhatsApp com uma mensagem sobre o serviço escolhido. Você decide se deseja enviá-la; nenhum pagamento é realizado aqui. O fluxo de compra digital acima é a experiência planejada, ainda sujeita à homologação do Portal.'}</p>
 </div>
</section>
<style>
 .quick-hire{padding-block:clamp(44px,6vw,90px);background:#fffdf9;scroll-margin-top:85px}
 .showcase-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:35px;margin-bottom:28px}
 .showcase-heading h2{max-width:830px;font-size:clamp(2rem,3.1vw,3rem);letter-spacing:-.04em;line-height:1.13;margin:10px 0 14px}
 .showcase-heading p:not(.eyebrow){color:#56534e;max-width:780px}
 .showcase-compare{max-width:290px;min-width:220px;color:#884100;font-weight:750;line-height:1.55;text-underline-offset:4px}
 .path-nav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:22px 0 50px}
 .path-nav a{min-height:116px;display:flex;align-items:center;gap:12px;padding:20px 18px;background:#fff;border:1px solid #e6d7c8;border-radius:16px;color:#171b19;text-decoration:none;box-shadow:0 8px 20px #171b1905}
 .path-nav a:hover{border-color:#f9941d;background:#fff7ed}
 .path-nav a>span:nth-child(2){display:grid;gap:5px;flex:1}
 .path-nav strong{font-size:1rem}
 .path-nav small{font-size:.85rem;color:#615a53;line-height:1.4}
 .path-icon{display:grid;place-items:center;flex:none;width:43px;height:43px;border-radius:12px;background:#ffead2;color:#8b4300;font-weight:850;font-size:22px}
 .offer-group{margin-top:46px;scroll-margin-top:90px}
 .offer-group-heading{margin-bottom:20px;max-width:820px}
 .offer-group-heading h3{font-size:clamp(1.6rem,2.7vw,2.4rem);line-height:1.18;letter-spacing:-.03em;margin:8px 0 10px}
 .offer-group-heading p:last-child{color:#5b554d;margin:0;line-height:1.6}
 .quick-hire-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
 .quick-hire-card{display:flex;flex-direction:column;min-width:0;padding:clamp(20px,2.6vw,32px);border:1px solid #e4ded6;border-radius:21px;background:#fff;box-shadow:0 12px 24px #171b1907}
 .offer-top{display:flex;justify-content:space-between;align-items:center;gap:12px}
 .offer-tag{display:inline-block;border-radius:100px;background:#fff0dd;color:#824000;padding:7px 12px;font-size:.74rem;font-weight:800;letter-spacing:.02em}
 .offer-arrow{font-size:24px;color:#a45a11}
 .quick-hire-card h4{font-size:clamp(1.5rem,2.2vw,2rem);line-height:1.2;margin:18px 0 8px;letter-spacing:-.03em}
 .offer-outcome{font-size:1.05rem;font-weight:690;line-height:1.5;margin:0 0 14px;color:#282724}
 .offer-for{color:#5b544d;font-size:.92rem;line-height:1.55;margin:0 0 20px}
 .offer-list-title{font-size:.8rem;letter-spacing:.02em;font-weight:830;color:#493c2f;margin:0 0 8px}
 .offer-includes{list-style:none;padding:0;margin:0 0 18px;display:grid;gap:8px}
 .offer-includes li{position:relative;padding-left:24px;font-size:.92rem;color:#45423e;line-height:1.5}
 .offer-includes li::before{content:'✓';position:absolute;left:0;top:0;color:#915000;font-weight:850}
 .offer-finance{margin-top:auto;padding:15px 0;border-top:1px solid #f0e8df}
 .offer-price{font-size:.88rem;font-weight:790;line-height:1.55;margin:0;color:#3b3026}
 .offer-media{font-size:.83rem;color:#6b5a48;line-height:1.55;margin:8px 0 0}
 .offer-availability{font-size:.8rem;color:#744c16;line-height:1.55;margin:8px 0 0}
 .quick-hire-links{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap}
 .quick-hire-details{display:inline-flex;align-items:center;min-height:44px;color:#884100;font-weight:740;text-underline-offset:4px}
 .quick-hire-action{display:inline-flex;justify-content:center;align-items:center;gap:10px;min-height:48px;text-align:center}
 .checkout-preview{display:grid;grid-template-columns:minmax(220px,.85fr) minmax(0,1.5fr);gap:28px;background:#171b19;color:#fff;border-radius:24px;padding:clamp(24px,4vw,46px);margin-top:48px}
 .checkout-preview .eyebrow{color:#ffba6c}
 .checkout-preview h3{font-size:clamp(1.65rem,2.5vw,2.4rem);line-height:1.16;margin:8px 0 16px}
 .checkout-preview p:not(.eyebrow){color:#e3e5e2;line-height:1.65}
 .checkout-preview ol{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
 .checkout-preview li{display:flex;flex-direction:column;gap:7px;padding:20px 18px;background:#272c28;border:1px solid #434a44;border-radius:15px}
 .checkout-preview li span{font-weight:850;color:#ffaf52;font-size:1rem}
 .checkout-preview li strong{font-size:1rem}
 .checkout-preview li small{font-size:.85rem;line-height:1.5;color:#d0d6d0}
 .quick-hire-notice{margin:16px 0 0;color:#655b50;line-height:1.65;font-size:.84rem;max-width:1100px}
 .quick-hire a:focus-visible{outline:3px solid #a95b00;outline-offset:4px}
 @media(max-width:1040px){.showcase-heading{display:block}.showcase-compare{display:inline-block;margin-top:12px}.path-nav{grid-template-columns:1fr}.path-nav a{min-height:82px}.checkout-preview{grid-template-columns:1fr}}
 @media(max-width:700px){.quick-hire-grid{grid-template-columns:1fr}.checkout-preview ol{grid-template-columns:1fr 1fr}}
 @media(max-width:500px){.quick-hire-card{padding:22px}.quick-hire-links{display:grid}.quick-hire-action{width:100%}.checkout-preview ol{grid-template-columns:1fr}.path-nav{gap:10px;margin-bottom:32px}.quick-hire{padding-block:38px}}
</style>
