---
import { renderLabView } from '../../render-fragment.mjs';
import { requireLabMode } from '../../lab-policy.mjs';
requireLabMode(process.env.IMAGINE_FAISCA_LAB);
const view = await renderLabView({ sourceRoot: import.meta.env.FAISCA_LAB_SOURCE_ROOT });
---
<style is:global set:html={view.css} />
<style>
  faisca-lab { display: block; }
  .lab-activation { max-width: 1360px; margin: 1rem auto; padding: 0 24px; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
  .lab-activation button { font: inherit; font-weight: 700; color: #fff; background: #222a27; padding: .75rem 1rem; border: 0; border-radius: .75rem; cursor: pointer; }
  .lab-activation button:focus-visible { outline: 3px solid #9a4d00; outline-offset: 3px; }
  .lab-activation p { margin: 0; color: #49514d; }
</style>
<faisca-lab>
  <div class="lab-activation">
    <button type="button" data-faisca-lab-start hidden>Ativar conversa de laboratório</button>
    <p data-faisca-lab-status role="status">A conversa será carregada quando você ativar.</p>
  </div>
  <div data-faisca-root data-lab-preview set:html={view.markup} />
</faisca-lab>
<script>
  import { bindLabHost } from '../../lazy-host.mjs';
  class FaiscaLabElement extends HTMLElement {
    #binding;
    connectedCallback() { this.#binding ??= bindLabHost(this); }
    disconnectedCallback() { this.#binding?.destroy(); this.#binding = undefined; }
  }
  if (!customElements.get('faisca-lab')) customElements.define('faisca-lab', FaiscaLabElement);
</script>
