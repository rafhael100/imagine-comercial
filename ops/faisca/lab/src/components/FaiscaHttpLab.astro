---
import { renderLabView } from '../../render-fragment.mjs';
import { requireLabMode } from '../../lab-policy.mjs';
requireLabMode(process.env.IMAGINE_FAISCA_LAB);
const view = await renderLabView({ sourceRoot: import.meta.env.FAISCA_LAB_SOURCE_ROOT, transport: 'loopback_http' });
---
<style is:global set:html={view.css} />
<style>
  faisca-http-lab { display: block; }
  .http-lab-activation { max-width: 1360px; margin: 1rem auto; padding: 0 24px; display: flex; gap: .75rem; align-items: center; flex-wrap: wrap; }
  .http-lab-activation h1 { flex-basis: 100%; font-size: 1.15rem; margin: 0; color: #222a27; }
  .http-lab-activation p { margin: 0; color: #49514d; overflow-wrap: anywhere; }
  .http-lab-notice { flex-basis: 100%; }
  .http-lab-activation button { font: inherit; font-weight: 700; color: #fff; background: #222a27; padding: .75rem 1rem; border: 0; border-radius: .75rem; cursor: pointer; }
  .http-lab-activation button:focus-visible { outline: 3px solid #9a4d00; outline-offset: 3px; }
  .http-lab-activation button:disabled { opacity: .65; cursor: default; }
  .http-lab-activation [hidden] { display: none; }
  [data-faisca-http-reconciliation] { flex-basis: 100%; white-space: pre-line; }
</style>
<faisca-http-lab>
  <section class="http-lab-activation" aria-label="Controles do laboratório HTTP">
    <h1>Faísca · Conversa com servidor local</h1>
    <p class="http-lab-notice">Use apenas mensagens fictícias. Este laboratório envia mensagens para um servidor no seu computador, com respostas simuladas e registros temporários. Nenhuma IA externa está conectada.</p>
    <button type="button" data-faisca-http-start hidden>Ativar conversa de laboratório</button>
    <button type="button" data-faisca-http-reconcile hidden disabled>Consultar resposta pendente</button>
    <p data-faisca-http-status role="status">A conversa será carregada quando você ativar.</p>
    <p data-faisca-http-reconciliation role="status"></p>
  </section>
  <div data-faisca-root data-lab-preview set:html={view.markup} />
</faisca-http-lab>
<script>
  import { bindHttpLabHost } from '../../http-host.mjs';
  class FaiscaHttpLabElement extends HTMLElement {
    #binding;
    connectedCallback() { this.#binding ??= bindHttpLabHost(this); }
    disconnectedCallback() { this.#binding?.destroy(); this.#binding = undefined; }
  }
  if (!customElements.get('faisca-http-lab')) customElements.define('faisca-http-lab', FaiscaHttpLabElement);
</script>
