---
import { renderLabView } from '../../render-fragment.mjs';
import { requireLabMode } from '../../lab-policy.mjs';
requireLabMode(process.env.IMAGINE_FAISCA_LAB);
const view = await renderLabView({ sourceRoot: import.meta.env.FAISCA_LAB_SOURCE_ROOT, transport: 'loopback_http' });
---
<style is:global set:html={view.css} />
<style>
  faisca-journey-http-r08-lab { display: block; }
  .journey-http-controls { max-width: 1360px; margin: 1rem auto; padding: 0 24px; display: flex; gap: .75rem; align-items: center; flex-wrap: wrap; }
  .journey-http-controls h1 { flex-basis: 100%; font-size: 1.15rem; margin: 0; color: #222a27; }
  .journey-http-controls p { margin: 0; color: #49514d; overflow-wrap: anywhere; }
  .journey-http-controls .notice { flex-basis: 100%; }
  .journey-http-controls button { font: inherit; font-weight: 700; color: #fff; background: #222a27; padding: .75rem 1rem; border: 0; border-radius: .75rem; cursor: pointer; }
  .journey-http-controls button:focus-visible { outline: 3px solid #9a4d00; outline-offset: 3px; }
  .journey-http-controls button:disabled { opacity: .65; cursor: default; }
  .journey-http-controls [hidden] { display: none; }
  [data-faisca-http-reconciliation] { flex-basis: 100%; white-space: pre-line; }
</style>
<faisca-journey-http-r08-lab>
  <section class="journey-http-controls" aria-label="Controles do laboratório R08">
    <h1>Faísca · Qualificação comercial com PHP real</h1>
    <p class="notice">Laboratório isolado. Use apenas mensagens fictícias. A sessão R08 é local ao servidor; respostas editoriais R07 podem ser conferidas pelo PHP real do Imagine Agents. Nenhuma IA externa, CRM, cobrança ou envio à equipe está conectado.</p>
    <p class="notice">A solução só entra no resumo após confirmação. A qualificação aceita opções fechadas. O resumo é copiável e nunca é enviado automaticamente.</p>
    <button type="button" data-faisca-http-start hidden>Ativar conversa R08 de laboratório</button>
    <button type="button" data-faisca-http-reconcile hidden disabled>Consultar resposta pendente</button>
    <p data-faisca-http-status role="status">A conversa será carregada quando você ativar.</p>
    <p data-faisca-http-reconciliation role="status"></p>
  </section>
  <div data-faisca-root data-lab-preview set:html={view.markup} />
</faisca-journey-http-r08-lab>
<script>
  import { bindHttpLabHost } from '../../http-host.mjs';
  class FaiscaJourneyHttpR08LabElement extends HTMLElement {
    #binding;
    connectedCallback() {
      this.#binding ??= bindHttpLabHost(this, () => import('../../../qualification/http-ui.mjs'));
    }
    disconnectedCallback() {
      this.#binding?.destroy();
      this.#binding = undefined;
    }
  }
  if (!customElements.get('faisca-journey-http-r08-lab')) {
    customElements.define('faisca-journey-http-r08-lab', FaiscaJourneyHttpR08LabElement);
  }
</script>
